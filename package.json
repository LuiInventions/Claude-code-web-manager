{
  "name": "jarvis-control-center",
  "version": "1.9.24",
  "private": true,
  "description": "Jarvis Control Center for your PC, projects, and code CLIs (Claude Code, Grok, ChatGPT Codex) — runs only on 127.0.0.1.",
  "author": {
    "name": "LT Digital Concepts",
    "email": "luisklee@proton.me"
  },
  "main": "build/electron/main.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "node --require ./build/scripts/ignore-unreadable-outside.cjs ./node_modules/next/dist/bin/next build --experimental-build-mode compile",
    "start": "set NODE_ENV=production&& tsx server.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle:server": "node build/scripts/bundle-server.mjs",
    "electron:dev": "npm run bundle:server && electron build/electron/main.js",
    "electron:build": "npm run build && npm run bundle:server && electron-builder --config build/electron-builder.yml --publish never"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@uppy/core": "^6.2.0",
    "@uppy/utils": "^7.2.0",
    "@uppy/xhr-upload": "^6.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dotenv": "^17.4.2",
    "highlight.js": "^11.11.1",
    "linkedom": "^0.18.12",
    "lucide-react": "^1.21.0",
    "next": "^15.5.19",
    "node-pty": "^1.1.0",
    "openai": "^6.44.0",
    "pngjs": "^7.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "^15.5.19",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
